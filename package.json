{
  "name": "pufferblow-client",
  "version": "1.0.0",
  "description": "Official desktop and web client for Pufferblow",
  "private": true,
  "main": "dist-electron/main.js",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k -n vite,tsup,electron \"vite --host 127.0.0.1 --port 5173\" \"tsup --watch\" \"wait-on tcp:127.0.0.1:5173 && wait-on dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build && tsup",
    "build:desktop": "npm run build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:voice": "node e2e/voice/run.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@floating-ui/react": "^0.27.16",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@pufferblow/spines": "file:../spines",
    "@tanstack/react-query": "^5.90.2",
    "@twemoji/svg": "^15.0.0",
    "electron-updater": "^6.8.11",
    "emoji-datasource-twitter": "^15.0.1",
    "emoji-mart": "^5.6.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.548.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.5",
    "@types/node": "^22",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^42.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^16.0.0",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.1.13",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.30.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "space.pufferblow.client",
    "productName": "Pufferblow",
    "copyright": "Pufferblow contributors",
    "artifactName": "Pufferblow-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "PufferBlow",
        "repo": "client",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network;Chat;InstantMessaging",
      "maintainer": "ramsy0dev <ramsy0dev@gmail.com>",
      "synopsis": "Self-hosted community platform",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "author": {
    "name": "ramsy0dev",
    "email": "ramsy0dev@gmail.com"
  },
  "homepage": "https://github.com/PufferBlow/client",
  "license": "GPL-3.0"
}
